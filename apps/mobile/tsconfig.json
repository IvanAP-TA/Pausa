{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pausa/api-types": [
        "../../packages/api-types/src/index.ts"
      ],
      "@messages/*": [
        "../../packages/messages/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "e2e",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
