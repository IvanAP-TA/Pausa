{
  "name": "@pausa/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export -p web && node scripts/postexport.mjs",
    "budget": "node scripts/budget.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "playwright test -c playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run build:web && npm run budget && npm run test:e2e"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/sofia-sans-extra-condensed": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/sofia-sans-extra-condensed": "^5.3.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "fflate": "^0.8.3",
    "qrcode-generator": "^1.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.3",
    "@types/react": "~19.3.0",
    "expo-atlas": "^0.5.0",
    "intl-messageformat": "^12.2.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
