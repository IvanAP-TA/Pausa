{
  "name": "pausa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/dev-lan.cjs",
    "e2e": "playwright test",
    "engine:build": "node scripts/engine-build.cjs",
    "tauri": "tauri",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pausa --local",
    "db:migrate:remote": "wrangler d1 migrations apply pausa --remote",
    "db:seed:local": "wrangler d1 execute pausa --local --file=./seed/seed.sql",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1',{recursive:true,force:true})\" && npm run db:migrate:local && npm run db:seed:local",
    "test": "vitest run"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sql.js": "^1.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
