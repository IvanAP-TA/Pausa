{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pausa",
  "version": "0.1.0",
  "identifier": "org.gnagno.pausa",
  "build": {
    "frontendDist": "./shell",
    "devUrl": "http://localhost:3000/it"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pausa",
        "url": "https://pausa.gnagno.org/it",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
