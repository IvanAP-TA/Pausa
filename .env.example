# Copy to .env.local for `npm run dev`. In production set these with `npx wrangler secret put <NAME>`.

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional in dev: the Google button hides when these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links via Resend (optional in dev: without it the link is printed in the dev terminal;
# required in production, where sign-in fails rather than logging links). EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=Pausa <accesso@pausa.gnagno.org>

# TMDB v4 read token (optional: without it, search only covers titles already in the database)
TMDB_API_TOKEN=

# Web Push: generate with `node scripts/vapid.cjs`. The private key is a secret in production (wrangler secret put VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pausa.gnagno.org

# Metrics page (/it/admin/metrics): comma-separated emails allowed to see it
ADMIN_EMAILS=
