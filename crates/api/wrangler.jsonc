{
  // The production Pausa v2 Worker owns pausa.gnagno.org.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pausa-v2",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-11-01",
  "vars": {
    "APP_URL": "https://pausa.gnagno.org",
    "EMAIL_FROM": "Pausa <accesso@pausa.gnagno.org>",
    "VAPID_SUBJECT": "https://pausa.gnagno.org",
    "VAPID_PUBLIC_KEY": "BEJy0i8fpCaWuS5UKwNcgiUzBhu05lty_yD1Yl_90rAwzrVHymgBxjFnkn0VW0LiLwNL162BekDjCmHiSBosRYI"
  },
  "build": {
    "command": "worker-build --release"
  },
  "routes": [
    {
      "pattern": "pausa.gnagno.org",
      "custom_domain": true
    }
  ],
  // Daily housekeeping (03:17 UTC): expired sessions and tokens, stale rate-limit counters, old guest accounts. See src/cleanup.rs.
  "triggers": {
    "crons": [
      "* * * * *",
      "0 17 * * *",
      "17 3 * * *"
    ]
  },
  // The Serata room: one Durable Object per room code, SQLite-backed (the only kind on the Workers free plan).
  "durable_objects": {
    "bindings": [
      {
        "name": "SERATA",
        "class_name": "SerataRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SerataRoom"
      ]
    }
  ],
  // The web client (static export of apps/mobile). Public pages and shells with a file of their own are served by the asset host
  // without waking the Worker; the dynamic private routes below are not files, so the Worker maps them to their shell
  // (src/lib.rs `serve_client`, pausa_core::shell). Unknown paths get the real 404 page, not a soft 200.
  "assets": {
    "directory": "../../apps/mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/*/c/*",
      // Only the old /me/* addresses need the Worker (redirects); listing them one by one keeps /me and /me/circles static.
      "/*/me/edit",
      "/*/me/diary",
      "/*/me/lists",
      "/*/me/import",
      "/*/me/imports",
      "/*/join/*",
      "/*/log/*",
      "/*/t/*",
      "/*/s/*",
      "/*/lists/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pausa-v2",
      "database_id": "256ec796-1078-4f98-9b15-55c22aa244b3",
      "migrations_dir": "../../migrations"
    }
  ]
}
