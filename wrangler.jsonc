{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pausa",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 03:17 UTC housekeeping and 17:00 UTC email digest (see scheduled() in worker.ts).
  "triggers": { "crons": ["17 3 * * *", "0 17 * * *"] },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "pausa" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pausa",
      // Replace with the id from `npx wrangler d1 create pausa` before the first deploy.
      // Local dev (`npm run db:migrate:local`) works with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
